#!/usr/bin/with-contenv sh
set -eu

OSSEC_CONF="${OSSEC_CONF:-/var/ossec/etc/ossec.conf}"
AGENT_CONFIG_DIR="${AGENT_CONFIG_DIR:-/agent-config}"
OSSEC_TEMPLATE="${OSSEC_TEMPLATE:-$AGENT_CONFIG_DIR/ossec.conf.template}"
SNIPPET_DIR="${SNIPPET_DIR:-$AGENT_CONFIG_DIR/snippets}"
S6_ENV_DIR="${S6_ENV_DIR:-/var/run/s6/container_environment}"
CUSTOM_MARKER_BEGIN="<!-- BEGIN local agent config snippets -->"
CUSTOM_MARKER_END="<!-- END local agent config snippets -->"

escape_sed_replacement() {
  printf '%s' "$1" | sed 's/[\/&]/\\&/g'
}

extract_xml_value() {
  xml_tag="$1"
  xml_file="$2"

  if [ ! -f "$xml_file" ]; then
    return 1
  fi

  sed -n "s:.*<$xml_tag>\\(.*\\)</$xml_tag>.*:\\1:p" "$xml_file" | head -n 1
}

if [ ! -f "$OSSEC_TEMPLATE" ]; then
  echo "Agent config template missing: $OSSEC_TEMPLATE."
  exit 1
fi

EXISTING_MANAGER="$(extract_xml_value "address" "$OSSEC_CONF" || true)"
EXISTING_MANAGER_PORT="$(extract_xml_value "port" "$OSSEC_CONF" || true)"

EFFECTIVE_WAZUH_MANAGER="${WAZUH_MANAGER:-$EXISTING_MANAGER}"
EFFECTIVE_WAZUH_MANAGER_PORT="${WAZUH_MANAGER_PORT:-${EXISTING_MANAGER_PORT:-1514}}"
EFFECTIVE_WAZUH_AGENT_NAME="${WAZUH_AGENT_NAME:-dvwa-agent}"
EFFECTIVE_WAZUH_AGENT_GROUP="${WAZUH_AGENT_GROUP:-default}"

if [ -z "$EFFECTIVE_WAZUH_MANAGER" ]; then
  echo "WAZUH manager address is empty. Refusing to overwrite $OSSEC_CONF with an invalid client configuration."
  exit 1
fi

if [ "${WAZUH_REGISTRATION_PASSWORD:-}" = "CHANGE_ME_OR_LEAVE_EMPTY_IF_NOT_USED" ]; then
  echo "WAZUH_REGISTRATION_PASSWORD is still set to the example placeholder. Clearing it for enrollment."
  if [ -d "$S6_ENV_DIR" ]; then
    : > "$S6_ENV_DIR/WAZUH_REGISTRATION_PASSWORD"
  fi
  export WAZUH_REGISTRATION_PASSWORD=""
fi

echo "Rendering Wazuh agent config with manager $EFFECTIVE_WAZUH_MANAGER:$EFFECTIVE_WAZUH_MANAGER_PORT."

TMP_CONF="$(mktemp)"
RENDERED_TEMPLATE="$(mktemp)"

sed \
  -e "s/__WAZUH_MANAGER__/$(escape_sed_replacement "$EFFECTIVE_WAZUH_MANAGER")/g" \
  -e "s/__WAZUH_MANAGER_PORT__/$(escape_sed_replacement "$EFFECTIVE_WAZUH_MANAGER_PORT")/g" \
  -e "s/__WAZUH_AGENT_NAME__/$(escape_sed_replacement "$EFFECTIVE_WAZUH_AGENT_NAME")/g" \
  -e "s/__WAZUH_AGENT_GROUP__/$(escape_sed_replacement "$EFFECTIVE_WAZUH_AGENT_GROUP")/g" \
  "$OSSEC_TEMPLATE" > "$RENDERED_TEMPLATE"

if ! grep -q "</ossec_config>" "$RENDERED_TEMPLATE"; then
  echo "Agent config template is invalid: missing </ossec_config> in $OSSEC_TEMPLATE."
  rm -f "$TMP_CONF" "$RENDERED_TEMPLATE"
  exit 1
fi

awk -v marker_begin="$CUSTOM_MARKER_BEGIN" -v marker_end="$CUSTOM_MARKER_END" '
  index($0, marker_begin) {
    skipping = 1
    next
  }
  index($0, marker_end) {
    skipping = 0
    next
  }
  skipping != 1 {
    print
  }
' "$RENDERED_TEMPLATE" > "$TMP_CONF"

has_snippets=0
if [ -d "$SNIPPET_DIR" ]; then
  for snippet in "$SNIPPET_DIR"/*.conf; do
    if [ -f "$snippet" ]; then
      has_snippets=1
      break
    fi
  done
fi

if [ "$has_snippets" -ne 1 ]; then
  cat "$TMP_CONF" > "$OSSEC_CONF"
  rm -f "$TMP_CONF" "$RENDERED_TEMPLATE"
  echo "Rendered $OSSEC_CONF from template without extra snippets."
  exit 0
fi

TMP_SNIPPETS="$(mktemp)"

{
  echo "  $CUSTOM_MARKER_BEGIN"
  for snippet in "$SNIPPET_DIR"/*.conf; do
    [ -f "$snippet" ] || continue
    echo "  <!-- Source: $snippet -->"
    sed 's/^/  /' "$snippet"
  done
  echo "  $CUSTOM_MARKER_END"
} > "$TMP_SNIPPETS"

awk -v snippets="$TMP_SNIPPETS" '
  /<\/ossec_config>/ && inserted == 0 {
    while ((getline line < snippets) > 0) {
      print line
    }
    close(snippets)
    inserted = 1
  }
  { print }
' "$TMP_CONF" > "$RENDERED_TEMPLATE"

cat "$RENDERED_TEMPLATE" > "$OSSEC_CONF"
rm -f "$TMP_CONF" "$TMP_SNIPPETS" "$RENDERED_TEMPLATE"

echo "Rendered $OSSEC_CONF from template and applied local snippets."
