#!/usr/bin/env sh
set -eu

OSSEC_CONF="${OSSEC_CONF:-/var/ossec/etc/ossec.conf}"
AGENT_CONFIG_DIR="${AGENT_CONFIG_DIR:-/agent-config}"
OSSEC_TEMPLATE="${OSSEC_TEMPLATE:-$AGENT_CONFIG_DIR/ossec.conf.template}"
SNIPPET_DIR="${SNIPPET_DIR:-$AGENT_CONFIG_DIR/snippets}"
CUSTOM_MARKER_BEGIN="<!-- BEGIN local agent config snippets -->"
CUSTOM_MARKER_END="<!-- END local agent config snippets -->"

escape_sed_replacement() {
  printf '%s' "$1" | sed 's/[\/&]/\\&/g'
}

if [ ! -f "$OSSEC_TEMPLATE" ]; then
  echo "Agent config template missing: $OSSEC_TEMPLATE."
  exit 1
fi

TMP_CONF="$(mktemp)"
RENDERED_TEMPLATE="$(mktemp)"

sed \
  -e "s/__WAZUH_MANAGER__/$(escape_sed_replacement "${WAZUH_MANAGER:-}")/g" \
  -e "s/__WAZUH_MANAGER_PORT__/$(escape_sed_replacement "${WAZUH_MANAGER_PORT:-1514}")/g" \
  -e "s/__WAZUH_AGENT_NAME__/$(escape_sed_replacement "${WAZUH_AGENT_NAME:-dvwa-agent}")/g" \
  -e "s/__WAZUH_AGENT_GROUP__/$(escape_sed_replacement "${WAZUH_AGENT_GROUP:-default}")/g" \
  "$OSSEC_TEMPLATE" > "$RENDERED_TEMPLATE"

if ! grep -q "</ossec_config>" "$RENDERED_TEMPLATE"; then
  echo "Agent config template is invalid: missing </ossec_config> in $OSSEC_TEMPLATE."
  rm -f "$TMP_CONF" "$RENDERED_TEMPLATE"
  exit 1
fi

awk -v marker_begin="$CUSTOM_MARKER_BEGIN" -v marker_end="$CUSTOM_MARKER_END" '
  index($0, marker_begin) {
    skipping = 1
    next
  }
  index($0, marker_end) {
    skipping = 0
    next
  }
  skipping != 1 {
    print
  }
' "$RENDERED_TEMPLATE" > "$TMP_CONF"

has_snippets=0
if [ -d "$SNIPPET_DIR" ]; then
  for snippet in "$SNIPPET_DIR"/*.conf; do
    if [ -f "$snippet" ]; then
      has_snippets=1
      break
    fi
  done
fi

if [ "$has_snippets" -ne 1 ]; then
  cat "$TMP_CONF" > "$OSSEC_CONF"
  rm -f "$TMP_CONF" "$RENDERED_TEMPLATE"
  echo "Rendered $OSSEC_CONF from template without extra snippets."
  exit 0
fi

TMP_SNIPPETS="$(mktemp)"

{
  echo "  $CUSTOM_MARKER_BEGIN"
  for snippet in "$SNIPPET_DIR"/*.conf; do
    [ -f "$snippet" ] || continue
    echo "  <!-- Source: $snippet -->"
    sed 's/^/  /' "$snippet"
  done
  echo "  $CUSTOM_MARKER_END"
} > "$TMP_SNIPPETS"

awk -v snippets="$TMP_SNIPPETS" '
  /<\/ossec_config>/ && inserted == 0 {
    while ((getline line < snippets) > 0) {
      print line
    }
    close(snippets)
    inserted = 1
  }
  { print }
' "$TMP_CONF" > "$RENDERED_TEMPLATE"

cat "$RENDERED_TEMPLATE" > "$OSSEC_CONF"
rm -f "$TMP_CONF" "$TMP_SNIPPETS" "$RENDERED_TEMPLATE"

echo "Rendered $OSSEC_CONF from template and applied local snippets."
