# Copy this file to .env and replace placeholders with your real values.
# Keep .env private. It contains manager address and enrollment secrets.

WAZUH_MANAGER=CHANGE_ME_MANAGER_IP_OR_FQDN
WAZUH_MANAGER_PORT=1514
WAZUH_REGISTRATION_SERVER=CHANGE_ME_MANAGER_IP_OR_FQDN
WAZUH_REGISTRATION_PORT=1515
WAZUH_REGISTRATION_PASSWORD=

WAZUH_AGENT_NAME=dvwa-agent
WAZUH_AGENT_GROUP=default
WAZUH_AGENT_IMAGE_TAG=4.13.0

DVWA_HTTP_PORT=8080
